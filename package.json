{
  "name": "modulo17_less",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "npm run copy && concurrently \"less-watch-compiler ./src/styles ./build/styles main.less\" \"chokidar src/index.html src/images/**/* -c \\\"npm run copy\\\"\"",
    "build": "lessc ./src/styles/main.less ./build/styles/main.css && npm run copy",
    "copy": "copyfiles -u 1 src/index.html src/images/**/* build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "less": "^4.2.0",
    "less-watch-compiler": "^1.16.3",
    "copyfiles": "^2.4.1",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^8.2.2"
  }
}
